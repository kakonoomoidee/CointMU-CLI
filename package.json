{
  "name": "cmu-cli",
  "version": "1.3.0",
  "codename": "Griffin",
  "description": "Primary development toolkit for the CointMU blockchain",
  "main": "dist/index.js",
  "bin": {
    "cmu": "dist/index.js"
  },
  "scripts": {
    "prebuild": "ts-node update-build.ts",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "fs-extra": "^11.1.1",
    "hardhat": "^3.12.0",
    "inquirer": "^8.2.4",
    "solc": "^0.8.36",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.1",
    "@types/inquirer": "^8.2.4",
    "@types/node": "^26.1.2",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "hardhat": {
      "adm-zip": "^0.6.0"
    },
    "solc": {
      "tmp": "^0.2.6"
    },
    "esbuild": "^0.28.1"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
